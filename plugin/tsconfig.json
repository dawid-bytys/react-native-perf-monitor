{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build",
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2019",
    "types": ["node"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "expo/config-plugins": ["../example/node_modules/expo/config-plugins"]
    }
  },
  "include": ["src"]
}
